# Secrets
.env

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Fetched/generated data, results, and figures -- large and reproducible from
# scripts/ given the raw inputs; see README.md for what's committed vs not.
data/*
results/*
figures/*
!data/.gitkeep
!results/.gitkeep
!figures/.gitkeep

# Committed on purpose: the curated outputs the paper's tables and figures
# are built from. Everything else under results/ and figures/ stays ignored.
!results/paper/
!results/paper/**
!figures/paper/
!figures/paper/**

# OS
.DS_Store
