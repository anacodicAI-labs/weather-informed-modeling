# Copy this file to .env and fill in real values. .env is gitignored.

# Copernicus Climate Data Store personal access token, needed by
# scripts/stage_era5_arco.py to read the ARCO ERA5 Zarr store.
# Register at https://cds.climate.copernicus.eu/ and get your key from
# https://cds.climate.copernicus.eu/how-to-api -- or place it in ~/.cdsapirc
# instead of this file (the script checks both).
CDSAPI_KEY=
